{
  "name": "grid-weather",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build && npm run licences",
    "licences": "node scripts/licences.mjs",
    "refresh:data": "node scripts/refresh-data.mjs",
    "refresh:boundaries": "node scripts/prepare-boundaries.mjs --fetch",
    "test:browser": "node scripts/browser-check.mjs",
    "browsers:install": "node scripts/install-browsers.mjs",
    "preview:image": "node scripts/social-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:gpu": "node scripts/gpu-check.mjs",
    "test:fonts": "node scripts/font-swap-check.mjs",
    "refresh:weather": "node scripts/refresh-weather-data.mjs && node scripts/record-wind.mjs && node scripts/record-model.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "author": "Harry Freeman",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hfreeman2025/grid-weather"
  }
}
